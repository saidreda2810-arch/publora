# ==============================================================================
# SRA Social Publisher - Comprehensive Production Environment Configuration
# ==============================================================================

# Core Application Server Configuration
PORT=3000
NODE_ENV="production"
APP_URL="https://ais-dev-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app"
SHARED_APP_URL="https://ais-pre-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app"

# AI Studio Injected Gemini Model Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cryptographic & Session Secrets (Minimum 32 random bytes)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_64_char_hex_random_secret_for_cookie_session_signing"
OAUTH_ENCRYPTION_KEY="replace_with_a_secure_32_byte_random_string_for_token_encryption"

# ------------------------------------------------------------------------------
# 1. Google Cloud, YouTube & Google Drive Credentials
# Console: https://console.cloud.google.com/apis/credentials
# Project ID: protean-braid-gc9s2
# Support Email: saidreda2810@gmail.com
# Required APIs to enable:
#   - YouTube Data API v3
#   - YouTube Analytics API
#   - Google Drive API
# Authorized Redirect URIs:
#   - https://ais-dev-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/youtube
#   - https://ais-pre-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/youtube
# Scopes:
#   - https://www.googleapis.com/auth/youtube.upload
#   - https://www.googleapis.com/auth/youtube.readonly
#   - https://www.googleapis.com/auth/yt-analytics.readonly
#   - https://www.googleapis.com/auth/drive.readonly
#   - https://www.googleapis.com/auth/drive.file
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret"

# ------------------------------------------------------------------------------
# 2. Meta (Facebook Pages & Instagram Professional) App Credentials
# Portal: https://developers.facebook.com/apps
# App Type: Business
# Products: Facebook Login for Business, Graph API
# Valid OAuth Redirect URIs:
#   - https://ais-dev-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/facebook
#   - https://ais-dev-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/instagram
#   - https://ais-pre-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/facebook
#   - https://ais-pre-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/instagram
# Scopes:
#   - pages_show_list, pages_read_engagement, pages_manage_posts
#   - instagram_basic, instagram_content_publish, instagram_manage_insights
# ------------------------------------------------------------------------------
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# ------------------------------------------------------------------------------
# 3. TikTok Login Kit & Content Posting API Credentials
# Portal: https://developers.tiktok.com/
# Products: Login Kit v2, Content Posting API
# Redirect URIs:
#   - https://ais-dev-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/tiktok
#   - https://ais-pre-zxipqzaziekjmsixhnilwx-245311395111.europe-west2.run.app/api/oauth/callback/tiktok
# Scopes:
#   - user.info.basic, video.publish, video.upload
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"

# ------------------------------------------------------------------------------
# 4. Storage & Uploads Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_BYTES=104857600 # 100MB
ALLOWED_MIME_TYPES="video/mp4,video/webm,video/quicktime,image/png,image/jpeg,image/webp"

# ------------------------------------------------------------------------------
# 5. Brute-Force / Credential-Stuffing Protection
# Enforced server-side on all /api/auth credential endpoints.
# Storage: in-process (single-instance deployment). For multi-instance
# deployments a shared store (Redis) is required — see docs.
# ------------------------------------------------------------------------------
BRUTE_FORCE_ENABLED=true
# Failed attempts per account email before temporary restriction
BRUTE_FORCE_ACCOUNT_MAX_FAILURES=5
BRUTE_FORCE_ACCOUNT_WINDOW_MS=600000
BRUTE_FORCE_ACCOUNT_RESTRICT_MS=900000
# Failed attempts per IP address before temporary restriction
BRUTE_FORCE_IP_MAX_FAILURES=30
BRUTE_FORCE_IP_WINDOW_MS=600000
BRUTE_FORCE_IP_RESTRICT_MS=1800000
# Stricter threshold for privileged accounts (admin roles and above)
BRUTE_FORCE_ADMIN_MAX_FAILURES=3
# Maximum restriction duration (escalation cap)
BRUTE_FORCE_MAX_RESTRICT_MS=7200000
# Progressive response delay after repeated failures (ms)
BRUTE_FORCE_PROGRESSIVE_DELAY_MS=250
BRUTE_FORCE_PROGRESSIVE_DELAY_MAX_MS=2000
BRUTE_FORCE_PROGRESSIVE_DELAY_AFTER=3
# failMode: 'open' allows auth if guard internals fail (logged); 'closed' denies
BRUTE_FORCE_FAIL_MODE=open
# Set to true (or hop count) ONLY when behind a trusted reverse proxy
# (e.g. Google Cloud Run, load balancer). Default false = direct clients.
TRUST_PROXY=false
# Expose dev-only auth token hints (verificationToken/testTokenHint/testOtpHint)
# NEVER enable in production.
SRA_EXPOSE_DEV_TOKENS=false
